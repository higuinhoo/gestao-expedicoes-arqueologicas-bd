digraph G {
graph [rankdir=TB, nodesep=0.65, ranksep=0.8, splines=polyline, bgcolor="white", pad=0.4, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=13, labelfontsize=15, labeldistance=2.1, labelangle=30, color="#64748b", fontcolor="#172f4d", penwidth=1.4, arrowsize=0.9];
label="MER conceitual completo | Gestão de Expedições Arqueológicas\nEngenharia da Informação (pé de galinha) · cardinalidades (mín,máx) nos dois extremos\nCada ponta indica quantas instâncias dessa entidade se relacionam com uma da ponta oposta.\nT,X: todo pesquisador pertence a exatamente um dos três subtipos. ISA ligado diretamente ao supertipo.\n(0,N) permite cadastro anterior aos filhos. FRAGMENTO é identificado por artefato + número.\nRN08/RN17/RN25: regras reforçadas por triggers. RN03 e RN20: verificação semântica na consulta 15.";
labelloc="t"; fontsize=18; fontname="DejaVu Sans";
instituicao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>INSTITUIÇÃO</B></FONT></TD></TR><TR><TD PORT="id_instituicao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_instituicao</U></FONT></TD></TR><TR><TD PORT="nome" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">nome</FONT></TD></TR><TR><TD PORT="sigla" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">sigla</FONT></TD></TR><TR><TD PORT="tipo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">tipo</FONT></TD></TR><TR><TD PORT="pais" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">pais</FONT></TD></TR><TR><TD PORT="uf" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">uf</FONT></TD></TR><TR><TD PORT="cidade" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">cidade</FONT></TD></TR></TABLE>>];
pesquisador [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>PESQUISADOR · T,X</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3d4">Especialização TOTAL e EXCLUSIVA (T,X)</TD></TR><TR><TD PORT="id_pesquisador" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_pesquisador</U></FONT></TD></TR><TR><TD PORT="nome" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">nome</FONT></TD></TR><TR><TD PORT="email" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">email</FONT></TD></TR><TR><TD PORT="registro_profissional" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">registro_profissional</FONT></TD></TR><TR><TD PORT="tipo_especializacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">tipo_especializacao</FONT></TD></TR><TR><TD PORT="situacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">situacao</FONT></TD></TR></TABLE>>];
arqueologo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>ARQUEÓLOGO</B></FONT></TD></TR><TR><TD PORT="id_pesquisador" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13"><U>id_pesquisador</U></FONT></TD></TR><TR><TD PORT="area_pesquisa" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13">area_pesquisa</FONT></TD></TR><TR><TD PORT="numero_autorizacao" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13">numero_autorizacao</FONT></TD></TR></TABLE>>];
conservador [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>CONSERVADOR</B></FONT></TD></TR><TR><TD PORT="id_pesquisador" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13"><U>id_pesquisador</U></FONT></TD></TR><TR><TD PORT="especialidade_material" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13">especialidade_material</FONT></TD></TR><TR><TD PORT="numero_registro" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13">numero_registro</FONT></TD></TR></TABLE>>];
analista_laboratorial [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>ANALISTA LABORATORIAL</B></FONT></TD></TR><TR><TD PORT="id_pesquisador" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13"><U>id_pesquisador</U></FONT></TD></TR><TR><TD PORT="especialidade_analise" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13">especialidade_analise</FONT></TD></TR><TR><TD PORT="nivel_formacao" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13">nivel_formacao</FONT></TD></TR></TABLE>>];
sitio_arqueologico [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>SÍTIO ARQUEOLÓGICO</B></FONT></TD></TR><TR><TD PORT="id_sitio" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_sitio</U></FONT></TD></TR><TR><TD PORT="nome" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">nome</FONT></TD></TR><TR><TD PORT="municipio" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">municipio</FONT></TD></TR><TR><TD PORT="uf" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">uf</FONT></TD></TR><TR><TD PORT="latitude" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">latitude</FONT></TD></TR><TR><TD PORT="longitude" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">longitude</FONT></TD></TR><TR><TD PORT="periodo_historico" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">periodo_historico</FONT></TD></TR><TR><TD PORT="nivel_protecao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">nivel_protecao</FONT></TD></TR><TR><TD PORT="data_cadastro" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_cadastro</FONT></TD></TR></TABLE>>];
campanha [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>CAMPANHA</B></FONT></TD></TR><TR><TD PORT="id_campanha" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_campanha</U></FONT></TD></TR><TR><TD PORT="codigo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">codigo</FONT></TD></TR><TR><TD PORT="nome" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">nome</FONT></TD></TR><TR><TD PORT="objetivo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">objetivo</FONT></TD></TR><TR><TD PORT="data_inicio" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_inicio</FONT></TD></TR><TR><TD PORT="data_fim" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_fim</FONT></TD></TR><TR><TD PORT="situacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">situacao</FONT></TD></TR><TR><TD PORT="orcamento" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">orcamento</FONT></TD></TR></TABLE>>];
participacao_campanha [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>PARTICIPAÇÃO EM CAMPANHA</B></FONT></TD></TR><TR><TD PORT="id_campanha" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_campanha</U></FONT></TD></TR><TR><TD PORT="id_pesquisador" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_pesquisador</U></FONT></TD></TR><TR><TD PORT="funcao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">funcao</FONT></TD></TR><TR><TD PORT="data_entrada" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_entrada</FONT></TD></TR><TR><TD PORT="data_saida" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_saida</FONT></TD></TR><TR><TD PORT="horas_previstas" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">horas_previstas</FONT></TD></TR></TABLE>>];
unidade_escavacao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>UNIDADE DE ESCAVAÇÃO</B></FONT></TD></TR><TR><TD PORT="id_unidade" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_unidade</U></FONT></TD></TR><TR><TD PORT="codigo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">codigo</FONT></TD></TR><TR><TD PORT="setor" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">setor</FONT></TD></TR><TR><TD PORT="nivel_estratigrafico" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">nivel_estratigrafico</FONT></TD></TR><TR><TD PORT="data_abertura" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_abertura</FONT></TD></TR><TR><TD PORT="data_encerramento" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_encerramento</FONT></TD></TR></TABLE>>];
artefato [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>ARTEFATO</B></FONT></TD></TR><TR><TD PORT="id_artefato" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_artefato</U></FONT></TD></TR><TR><TD PORT="codigo_catalogo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">codigo_catalogo</FONT></TD></TR><TR><TD PORT="nome" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">nome</FONT></TD></TR><TR><TD PORT="descricao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">descricao</FONT></TD></TR><TR><TD PORT="material" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">material</FONT></TD></TR><TR><TD PORT="periodo_estimado" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">periodo_estimado</FONT></TD></TR><TR><TD PORT="data_descoberta" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_descoberta</FONT></TD></TR><TR><TD PORT="profundidade_cm" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">profundidade_cm</FONT></TD></TR><TR><TD PORT="estado_conservacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">estado_conservacao</FONT></TD></TR><TR><TD PORT="situacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">situacao</FONT></TD></TR></TABLE>>];
fragmento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>FRAGMENTO · FRACA</B></FONT></TD></TR><TR><TD PORT="id_artefato" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_artefato</U></FONT></TD></TR><TR><TD PORT="numero_fragmento" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>numero_fragmento</U></FONT></TD></TR><TR><TD PORT="peso_g" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">peso_g</FONT></TD></TR><TR><TD PORT="comprimento_mm" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">comprimento_mm</FONT></TD></TR><TR><TD PORT="descricao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">descricao</FONT></TD></TR><TR><TD PORT="localizado" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">localizado</FONT></TD></TR></TABLE>>];
analise_laboratorial [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>ANÁLISE LABORATORIAL</B></FONT></TD></TR><TR><TD PORT="id_analise" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_analise</U></FONT></TD></TR><TR><TD PORT="tipo_analise" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">tipo_analise</FONT></TD></TR><TR><TD PORT="metodo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">metodo</FONT></TD></TR><TR><TD PORT="data_inicio" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_inicio</FONT></TD></TR><TR><TD PORT="data_fim" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_fim</FONT></TD></TR><TR><TD PORT="situacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">situacao</FONT></TD></TR><TR><TD PORT="custo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">custo</FONT></TD></TR></TABLE>>];
artefato_analise [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>ARTEFATO / ANÁLISE</B></FONT></TD></TR><TR><TD PORT="id_artefato" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_artefato</U></FONT></TD></TR><TR><TD PORT="id_analise" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_analise</U></FONT></TD></TR><TR><TD PORT="codigo_amostra" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">codigo_amostra</FONT></TD></TR><TR><TD PORT="massa_consumida_g" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">massa_consumida_g</FONT></TD></TR><TR><TD PORT="resultado_resumido" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">resultado_resumido</FONT></TD></TR><TR><TD PORT="conclusao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">conclusao</FONT></TD></TR></TABLE>>];
intervencao_conservacao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>INTERVENÇÃO DE CONSERVAÇÃO</B></FONT></TD></TR><TR><TD PORT="id_intervencao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_intervencao</U></FONT></TD></TR><TR><TD PORT="tipo_intervencao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">tipo_intervencao</FONT></TD></TR><TR><TD PORT="data_inicio" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_inicio</FONT></TD></TR><TR><TD PORT="data_fim" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_fim</FONT></TD></TR><TR><TD PORT="descricao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">descricao</FONT></TD></TR><TR><TD PORT="material_aplicado" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">material_aplicado</FONT></TD></TR><TR><TD PORT="situacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">situacao</FONT></TD></TR><TR><TD PORT="custo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">custo</FONT></TD></TR></TABLE>>];
local_armazenamento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>LOCAL DE ARMAZENAMENTO</B></FONT></TD></TR><TR><TD PORT="id_local" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_local</U></FONT></TD></TR><TR><TD PORT="codigo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">codigo</FONT></TD></TR><TR><TD PORT="tipo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">tipo</FONT></TD></TR><TR><TD PORT="temperatura_c" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">temperatura_c</FONT></TD></TR><TR><TD PORT="umidade_percentual" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">umidade_percentual</FONT></TD></TR><TR><TD PORT="capacidade" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">capacidade</FONT></TD></TR></TABLE>>];
custodia_artefato [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>CUSTÓDIA DO ARTEFATO</B></FONT></TD></TR><TR><TD PORT="id_custodia" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_custodia</U></FONT></TD></TR><TR><TD PORT="data_inicio" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_inicio</FONT></TD></TR><TR><TD PORT="data_fim" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_fim</FONT></TD></TR><TR><TD PORT="documento_movimentacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">documento_movimentacao</FONT></TD></TR><TR><TD PORT="motivo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">motivo</FONT></TD></TR></TABLE>>];
{rank=same; instituicao; sitio_arqueologico;}
{rank=same; arqueologo; conservador; analista_laboratorial;}
{rank=same; participacao_campanha; unidade_escavacao;}
{rank=same; fragmento; artefato_analise; intervencao_conservacao; custodia_artefato;}
instituicao -> pesquisador [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="vincula", tailport="id_instituicao:e", headport="id_pesquisador:w"];
pesquisador -> arqueologo [dir=both, arrowtail=teetee, arrowhead=teeodot, taillabel="(1,1)", headlabel="(0,1)", label="ISA", tailport="nome:e", headport="id_pesquisador:w", style=dashed, color="#b7791f"];
pesquisador -> conservador [dir=both, arrowtail=teetee, arrowhead=teeodot, taillabel="(1,1)", headlabel="(0,1)", label="ISA", tailport="email:e", headport="id_pesquisador:w", style=dashed, color="#b7791f"];
pesquisador -> analista_laboratorial [dir=both, arrowtail=teetee, arrowhead=teeodot, taillabel="(1,1)", headlabel="(0,1)", label="ISA", tailport="registro_profissional:e", headport="id_pesquisador:w", style=dashed, color="#b7791f"];
sitio_arqueologico -> campanha [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="recebe", tailport="id_sitio:e", headport="id_campanha:w"];
pesquisador -> campanha [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="coordena [RN08]", tailport="tipo_especializacao:e", headport="codigo:w"];
campanha -> participacao_campanha [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="possui", tailport="nome:e", headport="id_campanha:w"];
pesquisador -> participacao_campanha [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="integra", tailport="situacao:e", headport="id_pesquisador:w"];
campanha -> unidade_escavacao [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="divide-se", tailport="objetivo:e", headport="id_unidade:w"];
unidade_escavacao -> artefato [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="revela", tailport="codigo:e", headport="id_artefato:w"];
artefato -> artefato [dir=both, arrowtail=teeodot, arrowhead=crowodot, taillabel="(0,1)", headlabel="(0,N)", label="referência", tailport="codigo_catalogo:e", headport="nome:w", constraint=false];
artefato -> fragmento [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="compõe / identificador", tailport="descricao:e", headport="id_artefato:w"];
instituicao -> analise_laboratorial [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="executa [RN17]", tailport="nome:e", headport="id_analise:w"];
artefato -> artefato_analise [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="participa", tailport="material:e", headport="id_artefato:w"];
analise_laboratorial -> artefato_analise [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="examina", tailport="tipo_analise:e", headport="id_analise:w"];
artefato -> intervencao_conservacao [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="recebe", tailport="periodo_estimado:e", headport="id_intervencao:w"];
conservador -> intervencao_conservacao [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="responsável conservador [RN20]", tailport="especialidade_material:e", headport="tipo_intervencao:w"];
instituicao -> local_armazenamento [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="possui", tailport="sigla:e", headport="id_local:w"];
artefato -> custodia_artefato [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="histórico datado", tailport="data_descoberta:e", headport="id_custodia:w"];
instituicao -> custodia_artefato [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="assume", tailport="tipo:e", headport="data_inicio:w"];
local_armazenamento -> custodia_artefato [dir=both, arrowtail=teeodot, arrowhead=crowodot, taillabel="(0,1)", headlabel="(0,N)", label="abriga [RN25]", tailport="codigo:e", headport="data_fim:w"];
pesquisador -> custodia_artefato [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="responde", tailport="situacao:e", headport="documento_movimentacao:w"];
}
