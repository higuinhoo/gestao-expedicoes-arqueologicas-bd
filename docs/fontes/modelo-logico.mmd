%% Fonte auxiliar; PDF canônico gerado a partir do DOT por scripts/gerar_modelos.py.
%% T,X no supertipo: especialização TOTAL e EXCLUSIVA. ISA não é uma entidade.
%% Campos entre aspas no MER marcam identificadores/derivação; tipos são domínios conceituais.
erDiagram
    INSTITUICAO {
        INT id_instituicao PK
        VARCHAR_120 nome
        VARCHAR_20 sigla
        VARCHAR_20 tipo
        VARCHAR_60 pais
        CHAR_2 uf
        VARCHAR_80 cidade
    }
    PESQUISADOR {
        INT id_pesquisador PK
        INT id_instituicao FK
        VARCHAR_120 nome
        VARCHAR_160 email
        VARCHAR_40 registro_profissional
        VARCHAR_24 tipo_especializacao
        VARCHAR_10 situacao
    }
    ARQUEOLOGO {
        INT id_pesquisador PK,FK
        VARCHAR_100 area_pesquisa
        VARCHAR_40 numero_autorizacao
    }
    CONSERVADOR {
        INT id_pesquisador PK,FK
        VARCHAR_80 especialidade_material
        VARCHAR_40 numero_registro
    }
    ANALISTA_LABORATORIAL {
        INT id_pesquisador PK,FK
        VARCHAR_100 especialidade_analise
        VARCHAR_30 nivel_formacao
    }
    SITIO_ARQUEOLOGICO {
        INT id_sitio PK
        VARCHAR_120 nome
        VARCHAR_80 municipio
        CHAR_2 uf
        DECIMAL_9_6 latitude
        DECIMAL_9_6 longitude
        VARCHAR_100 periodo_historico
        VARCHAR_20 nivel_protecao
        DATE data_cadastro
    }
    CAMPANHA {
        INT id_campanha PK
        INT id_sitio FK
        INT id_coordenador FK
        VARCHAR_24 codigo
        VARCHAR_140 nome
        TEXT objetivo
        DATE data_inicio
        DATE data_fim
        VARCHAR_16 situacao
        DECIMAL_12_2 orcamento
    }
