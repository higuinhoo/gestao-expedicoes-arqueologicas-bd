        INT id_campanha PK,FK
        INT id_pesquisador PK,FK
        VARCHAR_60 funcao
        DATE data_entrada
        DATE data_saida
        SMALLINT horas_previstas
    }
    UNIDADE_ESCAVACAO {
        INT id_unidade PK
        INT id_campanha FK
        VARCHAR_20 codigo
        VARCHAR_40 setor
        VARCHAR_40 nivel_estratigrafico
        DATE data_abertura
        DATE data_encerramento
    }
    ARTEFATO {
        INT id_artefato PK
        INT id_unidade FK
        INT id_artefato_referencia FK
        VARCHAR_32 codigo_catalogo
        VARCHAR_120 nome
        TEXT descricao
