@startuml
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 18
skinparam nodesep 65
skinparam ranksep 85
skinparam ArrowColor #3A4653
skinparam ArrowThickness 1.3
skinparam EntityBackgroundColor #FFFFFF
skinparam EntityBorderColor #223447
skinparam RelationshipBackgroundColor #F1F4F7
skinparam RelationshipBorderColor #223447
skinparam AttributeBackgroundColor #FFFFFF
skinparam AttributeBorderColor #718096

hide circle
hide methods
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #223447
skinparam classFontColor #172B3A
skinparam classHeaderBackgroundColor #EAF0F5
entity "instituicao" as instituicao {
  * <u>id_instituicao</u> : INT [PK]
  --
  * nome : VARCHAR(120)
    sigla : VARCHAR(20)
  * tipo : VARCHAR(20)
  * pais : VARCHAR(60)
    uf : CHAR(2)
  * cidade : VARCHAR(80)
}
entity "conservador" as conservador {
  * <u>id_pesquisador</u> : INT [PK/FK]
  --
  * especialidade_material : VARCHAR(80)
  * numero_registro : VARCHAR(40)
}
entity "artefato" as artefato {
  * <u>id_artefato</u> : INT [PK]
  --
  * id_unidade : INT [FK]
    id_artefato_referencia : INT [FK]
  * codigo_catalogo : VARCHAR(32)
  * nome : VARCHAR(120)
  * descricao : TEXT
  * material : VARCHAR(60)
    periodo_estimado : VARCHAR(100)
  * data_descoberta : DATE
  * profundidade_cm : DECIMAL(7,2)
  * estado_conservacao : VARCHAR(16)
  * situacao : VARCHAR(18)
}
entity "analise_laboratorial" as analise_laboratorial {
  * <u>id_analise</u> : INT [PK]
  --
  * id_laboratorio : INT [FK]
  * tipo_analise : VARCHAR(60)
  * metodo : VARCHAR(120)
  * data_inicio : DATE
    data_fim : DATE
  * situacao : VARCHAR(16)
  * custo : DECIMAL(10,2)
}
entity "artefato_analise" as artefato_analise {
  * <u>id_artefato</u> : INT [PK/FK]
  * <u>id_analise</u> : INT [PK/FK]
  --
  * codigo_amostra : VARCHAR(32)
  * massa_consumida_g : DECIMAL(8,3)
    resultado_resumido : VARCHAR(300)
    conclusao : TEXT
}
entity "intervencao_conservacao" as intervencao_conservacao {
  * <u>id_intervencao</u> : INT [PK]
  --
  * id_artefato : INT [FK]
  * id_conservador : INT [FK]
  * tipo_intervencao : VARCHAR(80)
  * data_inicio : DATE
    data_fim : DATE
  * descricao : TEXT
    material_aplicado : VARCHAR(160)
  * situacao : VARCHAR(16)
  * custo : DECIMAL(10,2)
}
artefato |o--o{ artefato : id_artefato_referencia
instituicao ||--o{ analise_laboratorial : id_laboratorio
artefato ||--o{ artefato_analise : id_artefato
analise_laboratorial ||--o{ artefato_analise : id_analise
artefato ||--o{ intervencao_conservacao : id_artefato
@enduml
