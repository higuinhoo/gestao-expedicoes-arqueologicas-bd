    }
    ANALISE_LABORATORIAL {
        INT id_analise PK
        INT id_laboratorio FK
        VARCHAR_60 tipo_analise
        VARCHAR_120 metodo
        DATE data_inicio
        DATE data_fim
        VARCHAR_16 situacao
        DECIMAL_10_2 custo
    }
    ARTEFATO_ANALISE {
        INT id_artefato PK,FK
        INT id_analise PK,FK
        VARCHAR_32 codigo_amostra
        DECIMAL_8_3 massa_consumida_g
        VARCHAR_300 resultado_resumido
