@startchen
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 18
skinparam nodesep 65
skinparam ranksep 85
skinparam ArrowColor #3A4653
skinparam ArrowThickness 1.3
skinparam EntityBackgroundColor #FFFFFF
skinparam EntityBorderColor #223447
skinparam RelationshipBackgroundColor #F1F4F7
skinparam RelationshipBorderColor #223447
skinparam AttributeBackgroundColor #FFFFFF
skinparam AttributeBorderColor #718096

entity "INSTITUIÇÃO" as instituicao {
  "id_instituicao" as id_instituicao <<key>>
  "nome" as nome
  "sigla" as sigla
  "tipo" as tipo
  "pais" as pais
  "uf" as uf
  "cidade" as cidade
}
entity "CONSERVADOR" as conservador {
  "especialidade_material" as especialidade_material
  "numero_registro" as numero_registro
}
entity "ARTEFATO" as artefato {
  "id_artefato" as id_artefato <<key>>
  "codigo_catalogo" as codigo_catalogo
  "nome" as nome
  "descricao" as descricao
  "material" as material
  "periodo_estimado" as periodo_estimado
  "data_descoberta" as data_descoberta
  "profundidade_cm" as profundidade_cm
  "estado_conservacao" as estado_conservacao
  "situacao" as situacao
}
entity "ANÁLISE LABORATORIAL" as analise_laboratorial {
  "id_analise" as id_analise <<key>>
  "tipo_analise" as tipo_analise
  "metodo" as metodo
  "data_inicio" as data_inicio
  "data_fim" as data_fim
  "situacao" as situacao
  "custo" as custo
}
entity "INTERVENÇÃO DE CONSERVAÇÃO" as intervencao_conservacao {
  "id_intervencao" as id_intervencao <<key>>
  "tipo_intervencao" as tipo_intervencao
  "data_inicio" as data_inicio
  "data_fim" as data_fim
  "descricao" as descricao
  "material_aplicado" as material_aplicado
  "situacao" as situacao
  "custo" as custo
}
relationship "Referencia" as r_referencia {
}
artefato -(0,1)- r_referencia
r_referencia -(0,N)- artefato
relationship "Executa" as r_executa {
}
instituicao -(0,N)- r_executa
r_executa -(1,1)- analise_laboratorial
relationship "É analisado em" as r_examina {
  codigo_amostra
  massa_consumida_g
  resultado_resumido
  conclusao
}
artefato -(0,N)- r_examina
r_examina -(0,N)- analise_laboratorial
relationship "Realiza" as r_realiza {
}
conservador -(0,N)- r_realiza
r_realiza -(1,1)- intervencao_conservacao
relationship "Recebe" as r_intervencoes {
}
artefato -(0,N)- r_intervencoes
r_intervencoes -(1,1)- intervencao_conservacao
@endchen
