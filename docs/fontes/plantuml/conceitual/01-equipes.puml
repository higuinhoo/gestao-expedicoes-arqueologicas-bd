@startchen
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 18
skinparam nodesep 65
skinparam ranksep 85
skinparam ArrowColor #3A4653
skinparam ArrowThickness 1.3
skinparam EntityBackgroundColor #FFFFFF
skinparam EntityBorderColor #223447
skinparam RelationshipBackgroundColor #F1F4F7
skinparam RelationshipBorderColor #223447
skinparam AttributeBackgroundColor #FFFFFF
skinparam AttributeBorderColor #718096

entity "INSTITUIÇÃO" as instituicao {
  "id_instituicao" as id_instituicao <<key>>
  "nome" as nome
  "sigla" as sigla
  "tipo" as tipo
  "pais" as pais
  "uf" as uf
  "cidade" as cidade
}
entity "PESQUISADOR" as pesquisador {
  "id_pesquisador" as id_pesquisador <<key>>
  "nome" as nome
  "email" as email
  "registro_profissional" as registro_profissional
  "situacao" as situacao
}
entity "ARQUEÓLOGO" as arqueologo {
  "area_pesquisa" as area_pesquisa
  "numero_autorizacao" as numero_autorizacao
}
entity "CONSERVADOR" as conservador {
  "especialidade_material" as especialidade_material
  "numero_registro" as numero_registro
}
entity "ANALISTA LABORATORIAL" as analista_laboratorial {
  "especialidade_analise" as especialidade_analise
  "nivel_formacao" as nivel_formacao
}
entity "CAMPANHA" as campanha {
  "id_campanha" as id_campanha <<key>>
  "codigo" as codigo
  "nome" as nome
  "objetivo" as objetivo
  "data_inicio" as data_inicio
  "data_fim" as data_fim
  "situacao" as situacao
  "orcamento" as orcamento
}
pesquisador =>= d { arqueologo, conservador, analista_laboratorial }
relationship "Vincula" as r_vincula {
}
instituicao -(0,N)- r_vincula
r_vincula -(1,1)- pesquisador
relationship "Participa" as r_participa {
  funcao
  data_entrada
  data_saida
  horas_previstas
}
pesquisador -(0,N)- r_participa
r_participa -(0,N)- campanha
relationship "Coordena" as r_coordena {
}
arqueologo -(0,N)- r_coordena
r_coordena -(1,1)- campanha
@endchen
