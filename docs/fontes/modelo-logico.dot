digraph G {
graph [rankdir=TB, nodesep=0.65, ranksep=0.8, splines=polyline, bgcolor="white", pad=0.4, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=13, labelfontsize=15, labeldistance=2.1, labelangle=30, color="#64748b", fontcolor="#172f4d", penwidth=1.4, arrowsize=0.9];
label="Modelo lógico relacional | Gestão de Expedições Arqueológicas\nEngenharia da Informação (pé de galinha) · cardinalidades (mín,máx) nos dois extremos\nCada ponta indica quantas instâncias dessa entidade se relacionam com uma da ponta oposta.\nT,X: todo pesquisador pertence a exatamente um dos três subtipos. ISA ligado diretamente ao supertipo.\n(0,N) permite cadastro anterior aos filhos. FRAGMENTO é identificado por artefato + número.\nRN08/RN17/RN25: regras reforçadas por triggers. RN03 e RN20: verificação semântica na consulta 15.";
labelloc="t"; fontsize=18; fontname="DejaVu Sans";
instituicao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>INSTITUIÇÃO</B></FONT></TD></TR><TR><TD PORT="id_instituicao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_instituicao</U> : INT [PK]</FONT></TD></TR><TR><TD PORT="nome" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">nome : VARCHAR(120)</FONT></TD></TR><TR><TD PORT="sigla" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">sigla : VARCHAR(20)</FONT></TD></TR><TR><TD PORT="tipo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">tipo : VARCHAR(20)</FONT></TD></TR><TR><TD PORT="pais" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">pais : VARCHAR(60)</FONT></TD></TR><TR><TD PORT="uf" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">uf : CHAR(2)</FONT></TD></TR><TR><TD PORT="cidade" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">cidade : VARCHAR(80)</FONT></TD></TR></TABLE>>];
pesquisador [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>PESQUISADOR · T,X</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3d4">Especialização TOTAL e EXCLUSIVA (T,X)</TD></TR><TR><TD PORT="id_pesquisador" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_pesquisador</U> : INT [PK]</FONT></TD></TR><TR><TD PORT="id_instituicao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_instituicao : INT [FK]</FONT></TD></TR><TR><TD PORT="nome" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">nome : VARCHAR(120)</FONT></TD></TR><TR><TD PORT="email" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">email : VARCHAR(160)</FONT></TD></TR><TR><TD PORT="registro_profissional" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">registro_profissional : VARCHAR(40)</FONT></TD></TR><TR><TD PORT="tipo_especializacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">tipo_especializacao : VARCHAR(24)</FONT></TD></TR><TR><TD PORT="situacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">situacao : VARCHAR(10)</FONT></TD></TR></TABLE>>];
arqueologo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>ARQUEÓLOGO</B></FONT></TD></TR><TR><TD PORT="id_pesquisador" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13"><U>id_pesquisador</U> : INT [PK/FK]</FONT></TD></TR><TR><TD PORT="area_pesquisa" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13">area_pesquisa : VARCHAR(100)</FONT></TD></TR><TR><TD PORT="numero_autorizacao" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13">numero_autorizacao : VARCHAR(40)</FONT></TD></TR></TABLE>>];
conservador [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>CONSERVADOR</B></FONT></TD></TR><TR><TD PORT="id_pesquisador" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13"><U>id_pesquisador</U> : INT [PK/FK]</FONT></TD></TR><TR><TD PORT="especialidade_material" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13">especialidade_material : VARCHAR(80)</FONT></TD></TR><TR><TD PORT="numero_registro" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13">numero_registro : VARCHAR(40)</FONT></TD></TR></TABLE>>];
analista_laboratorial [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>ANALISTA LABORATORIAL</B></FONT></TD></TR><TR><TD PORT="id_pesquisador" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13"><U>id_pesquisador</U> : INT [PK/FK]</FONT></TD></TR><TR><TD PORT="especialidade_analise" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13">especialidade_analise : VARCHAR(100)</FONT></TD></TR><TR><TD PORT="nivel_formacao" ALIGN="LEFT" BGCOLOR="#fff3d4"><FONT POINT-SIZE="13">nivel_formacao : VARCHAR(30)</FONT></TD></TR></TABLE>>];
sitio_arqueologico [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>SÍTIO ARQUEOLÓGICO</B></FONT></TD></TR><TR><TD PORT="id_sitio" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_sitio</U> : INT [PK]</FONT></TD></TR><TR><TD PORT="nome" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">nome : VARCHAR(120)</FONT></TD></TR><TR><TD PORT="municipio" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">municipio : VARCHAR(80)</FONT></TD></TR><TR><TD PORT="uf" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">uf : CHAR(2)</FONT></TD></TR><TR><TD PORT="latitude" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">latitude : DECIMAL(9,6)</FONT></TD></TR><TR><TD PORT="longitude" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">longitude : DECIMAL(9,6)</FONT></TD></TR><TR><TD PORT="periodo_historico" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">periodo_historico : VARCHAR(100)</FONT></TD></TR><TR><TD PORT="nivel_protecao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">nivel_protecao : VARCHAR(20)</FONT></TD></TR><TR><TD PORT="data_cadastro" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_cadastro : DATE</FONT></TD></TR></TABLE>>];
campanha [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>CAMPANHA</B></FONT></TD></TR><TR><TD PORT="id_campanha" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_campanha</U> : INT [PK]</FONT></TD></TR><TR><TD PORT="id_sitio" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_sitio : INT [FK]</FONT></TD></TR><TR><TD PORT="id_coordenador" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_coordenador : INT [FK]</FONT></TD></TR><TR><TD PORT="codigo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">codigo : VARCHAR(24)</FONT></TD></TR><TR><TD PORT="nome" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">nome : VARCHAR(140)</FONT></TD></TR><TR><TD PORT="objetivo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">objetivo : TEXT</FONT></TD></TR><TR><TD PORT="data_inicio" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_inicio : DATE</FONT></TD></TR><TR><TD PORT="data_fim" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_fim : DATE</FONT></TD></TR><TR><TD PORT="situacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">situacao : VARCHAR(16)</FONT></TD></TR><TR><TD PORT="orcamento" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">orcamento : DECIMAL(12,2)</FONT></TD></TR></TABLE>>];
participacao_campanha [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>PARTICIPAÇÃO EM CAMPANHA</B></FONT></TD></TR><TR><TD PORT="id_campanha" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_campanha</U> : INT [PK/FK]</FONT></TD></TR><TR><TD PORT="id_pesquisador" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_pesquisador</U> : INT [PK/FK]</FONT></TD></TR><TR><TD PORT="funcao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">funcao : VARCHAR(60)</FONT></TD></TR><TR><TD PORT="data_entrada" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_entrada : DATE</FONT></TD></TR><TR><TD PORT="data_saida" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_saida : DATE</FONT></TD></TR><TR><TD PORT="horas_previstas" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">horas_previstas : SMALLINT</FONT></TD></TR></TABLE>>];
unidade_escavacao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>UNIDADE DE ESCAVAÇÃO</B></FONT></TD></TR><TR><TD PORT="id_unidade" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_unidade</U> : INT [PK]</FONT></TD></TR><TR><TD PORT="id_campanha" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_campanha : INT [FK]</FONT></TD></TR><TR><TD PORT="codigo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">codigo : VARCHAR(20)</FONT></TD></TR><TR><TD PORT="setor" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">setor : VARCHAR(40)</FONT></TD></TR><TR><TD PORT="nivel_estratigrafico" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">nivel_estratigrafico : VARCHAR(40)</FONT></TD></TR><TR><TD PORT="data_abertura" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_abertura : DATE</FONT></TD></TR><TR><TD PORT="data_encerramento" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_encerramento : DATE</FONT></TD></TR></TABLE>>];
artefato [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>ARTEFATO</B></FONT></TD></TR><TR><TD PORT="id_artefato" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_artefato</U> : INT [PK]</FONT></TD></TR><TR><TD PORT="id_unidade" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_unidade : INT [FK]</FONT></TD></TR><TR><TD PORT="id_artefato_referencia" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_artefato_referencia : INT [FK]</FONT></TD></TR><TR><TD PORT="codigo_catalogo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">codigo_catalogo : VARCHAR(32)</FONT></TD></TR><TR><TD PORT="nome" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">nome : VARCHAR(120)</FONT></TD></TR><TR><TD PORT="descricao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">descricao : TEXT</FONT></TD></TR><TR><TD PORT="material" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">material : VARCHAR(60)</FONT></TD></TR><TR><TD PORT="periodo_estimado" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">periodo_estimado : VARCHAR(100)</FONT></TD></TR><TR><TD PORT="data_descoberta" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_descoberta : DATE</FONT></TD></TR><TR><TD PORT="profundidade_cm" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">profundidade_cm : DECIMAL(7,2)</FONT></TD></TR><TR><TD PORT="estado_conservacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">estado_conservacao : VARCHAR(16)</FONT></TD></TR><TR><TD PORT="situacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">situacao : VARCHAR(18)</FONT></TD></TR></TABLE>>];
fragmento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>FRAGMENTO · FRACA</B></FONT></TD></TR><TR><TD PORT="id_artefato" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_artefato</U> : INT [PK/FK]</FONT></TD></TR><TR><TD PORT="numero_fragmento" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>numero_fragmento</U> : SMALLINT [PK]</FONT></TD></TR><TR><TD PORT="peso_g" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">peso_g : DECIMAL(9,3)</FONT></TD></TR><TR><TD PORT="comprimento_mm" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">comprimento_mm : DECIMAL(8,2)</FONT></TD></TR><TR><TD PORT="descricao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">descricao : VARCHAR(240)</FONT></TD></TR><TR><TD PORT="localizado" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">localizado : BOOLEAN</FONT></TD></TR></TABLE>>];
analise_laboratorial [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>ANÁLISE LABORATORIAL</B></FONT></TD></TR><TR><TD PORT="id_analise" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_analise</U> : INT [PK]</FONT></TD></TR><TR><TD PORT="id_laboratorio" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_laboratorio : INT [FK]</FONT></TD></TR><TR><TD PORT="tipo_analise" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">tipo_analise : VARCHAR(60)</FONT></TD></TR><TR><TD PORT="metodo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">metodo : VARCHAR(120)</FONT></TD></TR><TR><TD PORT="data_inicio" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_inicio : DATE</FONT></TD></TR><TR><TD PORT="data_fim" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_fim : DATE</FONT></TD></TR><TR><TD PORT="situacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">situacao : VARCHAR(16)</FONT></TD></TR><TR><TD PORT="custo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">custo : DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
artefato_analise [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>ARTEFATO / ANÁLISE</B></FONT></TD></TR><TR><TD PORT="id_artefato" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_artefato</U> : INT [PK/FK]</FONT></TD></TR><TR><TD PORT="id_analise" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_analise</U> : INT [PK/FK]</FONT></TD></TR><TR><TD PORT="codigo_amostra" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">codigo_amostra : VARCHAR(32)</FONT></TD></TR><TR><TD PORT="massa_consumida_g" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">massa_consumida_g : DECIMAL(8,3)</FONT></TD></TR><TR><TD PORT="resultado_resumido" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">resultado_resumido : VARCHAR(300)</FONT></TD></TR><TR><TD PORT="conclusao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">conclusao : TEXT</FONT></TD></TR></TABLE>>];
intervencao_conservacao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>INTERVENÇÃO DE CONSERVAÇÃO</B></FONT></TD></TR><TR><TD PORT="id_intervencao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_intervencao</U> : INT [PK]</FONT></TD></TR><TR><TD PORT="id_artefato" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_artefato : INT [FK]</FONT></TD></TR><TR><TD PORT="id_conservador" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_conservador : INT [FK]</FONT></TD></TR><TR><TD PORT="tipo_intervencao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">tipo_intervencao : VARCHAR(80)</FONT></TD></TR><TR><TD PORT="data_inicio" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_inicio : DATE</FONT></TD></TR><TR><TD PORT="data_fim" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_fim : DATE</FONT></TD></TR><TR><TD PORT="descricao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">descricao : TEXT</FONT></TD></TR><TR><TD PORT="material_aplicado" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">material_aplicado : VARCHAR(160)</FONT></TD></TR><TR><TD PORT="situacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">situacao : VARCHAR(16)</FONT></TD></TR><TR><TD PORT="custo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">custo : DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
local_armazenamento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>LOCAL DE ARMAZENAMENTO</B></FONT></TD></TR><TR><TD PORT="id_local" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_local</U> : INT [PK]</FONT></TD></TR><TR><TD PORT="id_instituicao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_instituicao : INT [FK]</FONT></TD></TR><TR><TD PORT="codigo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">codigo : VARCHAR(24)</FONT></TD></TR><TR><TD PORT="tipo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">tipo : VARCHAR(30)</FONT></TD></TR><TR><TD PORT="temperatura_c" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">temperatura_c : DECIMAL(5,2)</FONT></TD></TR><TR><TD PORT="umidade_percentual" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">umidade_percentual : DECIMAL(5,2)</FONT></TD></TR><TR><TD PORT="capacidade" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">capacidade : INT</FONT></TD></TR></TABLE>>];
custodia_artefato [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#19334f"><TR><TD BGCOLOR="#19334f"><FONT COLOR="white" POINT-SIZE="16"><B>CUSTÓDIA DO ARTEFATO</B></FONT></TD></TR><TR><TD PORT="id_custodia" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13"><U>id_custodia</U> : INT [PK]</FONT></TD></TR><TR><TD PORT="id_artefato" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_artefato : INT [FK]</FONT></TD></TR><TR><TD PORT="id_instituicao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_instituicao : INT [FK]</FONT></TD></TR><TR><TD PORT="id_local" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_local : INT [FK]</FONT></TD></TR><TR><TD PORT="id_responsavel" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_responsavel : INT [FK]</FONT></TD></TR><TR><TD PORT="data_inicio" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_inicio : DATE</FONT></TD></TR><TR><TD PORT="data_fim" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">data_fim : DATE</FONT></TD></TR><TR><TD PORT="documento_movimentacao" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">documento_movimentacao : VARCHAR(40)</FONT></TD></TR><TR><TD PORT="motivo" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">motivo : VARCHAR(200)</FONT></TD></TR><TR><TD PORT="id_artefato_em_aberto" ALIGN="LEFT" BGCOLOR="#eaf0f7"><FONT POINT-SIZE="13">id_artefato_em_aberto : INT [gerado]</FONT></TD></TR></TABLE>>];
{rank=same; instituicao; sitio_arqueologico;}
{rank=same; arqueologo; conservador; analista_laboratorial;}
{rank=same; participacao_campanha; unidade_escavacao;}
{rank=same; fragmento; artefato_analise; intervencao_conservacao; custodia_artefato;}
instituicao -> pesquisador [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="vincula", tailport="id_instituicao:e", headport="id_pesquisador:w"];
pesquisador -> arqueologo [dir=both, arrowtail=teetee, arrowhead=teeodot, taillabel="(1,1)", headlabel="(0,1)", label="ISA", tailport="id_instituicao:e", headport="id_pesquisador:w", style=dashed, color="#b7791f"];
pesquisador -> conservador [dir=both, arrowtail=teetee, arrowhead=teeodot, taillabel="(1,1)", headlabel="(0,1)", label="ISA", tailport="nome:e", headport="id_pesquisador:w", style=dashed, color="#b7791f"];
pesquisador -> analista_laboratorial [dir=both, arrowtail=teetee, arrowhead=teeodot, taillabel="(1,1)", headlabel="(0,1)", label="ISA", tailport="email:e", headport="id_pesquisador:w", style=dashed, color="#b7791f"];
sitio_arqueologico -> campanha [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="recebe", tailport="id_sitio:e", headport="id_campanha:w"];
pesquisador -> campanha [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="coordena [RN08]", tailport="registro_profissional:e", headport="id_sitio:w"];
campanha -> participacao_campanha [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="possui", tailport="id_coordenador:e", headport="id_campanha:w"];
pesquisador -> participacao_campanha [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="integra", tailport="tipo_especializacao:e", headport="id_pesquisador:w"];
campanha -> unidade_escavacao [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="divide-se", tailport="codigo:e", headport="id_unidade:w"];
unidade_escavacao -> artefato [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="revela", tailport="id_campanha:e", headport="id_artefato:w"];
artefato -> artefato [dir=both, arrowtail=teeodot, arrowhead=crowodot, taillabel="(0,1)", headlabel="(0,N)", label="referência", tailport="id_unidade:e", headport="id_artefato_referencia:w", constraint=false];
artefato -> fragmento [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="compõe / identificador", tailport="codigo_catalogo:e", headport="id_artefato:w"];
instituicao -> analise_laboratorial [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="executa [RN17]", tailport="nome:e", headport="id_analise:w"];
artefato -> artefato_analise [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="participa", tailport="nome:e", headport="id_artefato:w"];
analise_laboratorial -> artefato_analise [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="examina", tailport="id_laboratorio:e", headport="id_analise:w"];
artefato -> intervencao_conservacao [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="recebe", tailport="descricao:e", headport="id_intervencao:w"];
pesquisador -> intervencao_conservacao [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="responsável conservador [RN20]", tailport="situacao:e", headport="id_artefato:w"];
instituicao -> local_armazenamento [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="possui", tailport="sigla:e", headport="id_local:w"];
artefato -> custodia_artefato [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="histórico datado", tailport="material:e", headport="id_custodia:w"];
instituicao -> custodia_artefato [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="assume", tailport="tipo:e", headport="id_artefato:w"];
local_armazenamento -> custodia_artefato [dir=both, arrowtail=teeodot, arrowhead=crowodot, taillabel="(0,1)", headlabel="(0,N)", label="abriga [RN25]", tailport="id_instituicao:e", headport="id_instituicao:w"];
pesquisador -> custodia_artefato [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", label="responde", tailport="situacao:e", headport="id_local:w"];
}
