@startuml
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 18
skinparam nodesep 65
skinparam ranksep 85
skinparam ArrowColor #3A4653
skinparam ArrowThickness 1.3
skinparam EntityBackgroundColor #FFFFFF
skinparam EntityBorderColor #223447
skinparam RelationshipBackgroundColor #F1F4F7
skinparam RelationshipBorderColor #223447
skinparam AttributeBackgroundColor #FFFFFF
skinparam AttributeBorderColor #718096

hide circle
hide methods
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #223447
skinparam classFontColor #172B3A
skinparam classHeaderBackgroundColor #EAF0F5
entity "instituicao" as instituicao {
  * <u>id_instituicao</u> : INT [PK]
  --
  * nome : VARCHAR(120)
    sigla : VARCHAR(20)
  * tipo : VARCHAR(20)
  * pais : VARCHAR(60)
    uf : CHAR(2)
  * cidade : VARCHAR(80)
}
entity "pesquisador" as pesquisador {
  * <u>id_pesquisador</u> : INT [PK]
  --
  * id_instituicao : INT [FK]
  * nome : VARCHAR(120)
  * email : VARCHAR(160)
    registro_profissional : VARCHAR(40)
  * tipo_especializacao : VARCHAR(24)
  * situacao : VARCHAR(10)
}
entity "artefato" as artefato {
  * <u>id_artefato</u> : INT [PK]
  --
  * id_unidade : INT [FK]
    id_artefato_referencia : INT [FK]
  * codigo_catalogo : VARCHAR(32)
  * nome : VARCHAR(120)
  * descricao : TEXT
  * material : VARCHAR(60)
    periodo_estimado : VARCHAR(100)
  * data_descoberta : DATE
  * profundidade_cm : DECIMAL(7,2)
  * estado_conservacao : VARCHAR(16)
  * situacao : VARCHAR(18)
}
entity "local_armazenamento" as local_armazenamento {
  * <u>id_local</u> : INT [PK]
  --
  * id_instituicao : INT [FK]
  * codigo : VARCHAR(24)
  * tipo : VARCHAR(30)
    temperatura_c : DECIMAL(5,2)
    umidade_percentual : DECIMAL(5,2)
  * capacidade : INT
}
entity "custodia_artefato" as custodia_artefato {
  * <u>id_custodia</u> : INT [PK]
  --
  * id_artefato : INT [FK]
  * id_instituicao : INT [FK]
    id_local : INT [FK]
  * id_responsavel : INT [FK]
  * data_inicio : DATE
    data_fim : DATE
  * documento_movimentacao : VARCHAR(40)
  * motivo : VARCHAR(200)
    id_artefato_em_aberto : INT [gerado]
}
instituicao ||--o{ pesquisador : id_instituicao
artefato |o--o{ artefato : id_artefato_referencia
instituicao ||--o{ local_armazenamento : id_instituicao
artefato ||--o{ custodia_artefato : id_artefato
instituicao ||--o{ custodia_artefato : id_instituicao
local_armazenamento |o--o{ custodia_artefato : id_local
pesquisador ||--o{ custodia_artefato : id_responsavel
@enduml
