@startchen
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 18
skinparam nodesep 65
skinparam ranksep 85
skinparam ArrowColor #3A4653
skinparam ArrowThickness 1.3
skinparam EntityBackgroundColor #FFFFFF
skinparam EntityBorderColor #223447
skinparam RelationshipBackgroundColor #F1F4F7
skinparam RelationshipBorderColor #223447
skinparam AttributeBackgroundColor #FFFFFF
skinparam AttributeBorderColor #718096

entity "INSTITUIÇÃO" as instituicao {
  "id_instituicao" as id_instituicao <<key>>
  "nome" as nome
  "sigla" as sigla
  "tipo" as tipo
  "pais" as pais
  "uf" as uf
  "cidade" as cidade
}
entity "PESQUISADOR" as pesquisador {
  "id_pesquisador" as id_pesquisador <<key>>
  "nome" as nome
  "email" as email
  "registro_profissional" as registro_profissional
  "situacao" as situacao
}
entity "ARTEFATO" as artefato {
  "id_artefato" as id_artefato <<key>>
  "codigo_catalogo" as codigo_catalogo
  "nome" as nome
  "descricao" as descricao
  "material" as material
  "periodo_estimado" as periodo_estimado
  "data_descoberta" as data_descoberta
  "profundidade_cm" as profundidade_cm
  "estado_conservacao" as estado_conservacao
  "situacao" as situacao
}
entity "LOCAL DE ARMAZENAMENTO" as local_armazenamento {
  "id_local" as id_local <<key>>
  "codigo" as codigo
  "tipo" as tipo
  "temperatura_c" as temperatura_c
  "umidade_percentual" as umidade_percentual
  "capacidade" as capacidade
}
entity "CUSTÓDIA DO ARTEFATO" as custodia_artefato {
  "id_custodia" as id_custodia <<key>>
  "data_inicio" as data_inicio
  "data_fim" as data_fim
  "documento_movimentacao" as documento_movimentacao
  "motivo" as motivo
}
relationship "Vincula" as r_vincula {
}
instituicao -(0,N)- r_vincula
r_vincula -(1,1)- pesquisador
relationship "Referencia" as r_referencia {
}
artefato -(0,1)- r_referencia
r_referencia -(0,N)- artefato
relationship "Possui" as r_locais {
}
instituicao -(0,N)- r_locais
r_locais -(1,1)- local_armazenamento
relationship "Tem histórico" as r_historico {
}
artefato -(0,N)- r_historico
r_historico -(1,1)- custodia_artefato
relationship "Assume" as r_assume {
}
instituicao -(0,N)- r_assume
r_assume -(1,1)- custodia_artefato
relationship "Abriga" as r_abriga {
}
local_armazenamento -(0,N)- r_abriga
r_abriga -(0,1)- custodia_artefato
relationship "Responsabiliza-se" as r_responsavel {
}
pesquisador -(0,N)- r_responsavel
r_responsavel -(1,1)- custodia_artefato
@endchen
