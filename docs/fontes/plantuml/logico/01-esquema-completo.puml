@startuml
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 18
skinparam nodesep 65
skinparam ranksep 85
skinparam ArrowColor #3A4653
skinparam ArrowThickness 1.3
skinparam EntityBackgroundColor #FFFFFF
skinparam EntityBorderColor #223447
skinparam RelationshipBackgroundColor #F1F4F7
skinparam RelationshipBorderColor #223447
skinparam AttributeBackgroundColor #FFFFFF
skinparam AttributeBorderColor #718096

hide circle
hide methods
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #223447
skinparam classFontColor #172B3A
skinparam classHeaderBackgroundColor #EAF0F5
entity "instituicao" as instituicao {
  * <u>id_instituicao</u> : INT [PK]
  --
  * nome : VARCHAR(120)
    sigla : VARCHAR(20)
  * tipo : VARCHAR(20)
  * pais : VARCHAR(60)
    uf : CHAR(2)
  * cidade : VARCHAR(80)
}
entity "pesquisador" as pesquisador {
  * <u>id_pesquisador</u> : INT [PK]
  --
  * id_instituicao : INT [FK]
  * nome : VARCHAR(120)
  * email : VARCHAR(160)
    registro_profissional : VARCHAR(40)
  * tipo_especializacao : VARCHAR(24)
  * situacao : VARCHAR(10)
}
entity "arqueologo" as arqueologo {
  * <u>id_pesquisador</u> : INT [PK/FK]
  --
  * area_pesquisa : VARCHAR(100)
  * numero_autorizacao : VARCHAR(40)
}
entity "conservador" as conservador {
  * <u>id_pesquisador</u> : INT [PK/FK]
  --
  * especialidade_material : VARCHAR(80)
  * numero_registro : VARCHAR(40)
}
entity "analista_laboratorial" as analista_laboratorial {
  * <u>id_pesquisador</u> : INT [PK/FK]
  --
  * especialidade_analise : VARCHAR(100)
  * nivel_formacao : VARCHAR(30)
}
entity "sitio_arqueologico" as sitio_arqueologico {
  * <u>id_sitio</u> : INT [PK]
  --
  * nome : VARCHAR(120)
  * municipio : VARCHAR(80)
  * uf : CHAR(2)
  * latitude : DECIMAL(9,6)
  * longitude : DECIMAL(9,6)
    periodo_historico : VARCHAR(100)
  * nivel_protecao : VARCHAR(20)
  * data_cadastro : DATE
}
entity "campanha" as campanha {
  * <u>id_campanha</u> : INT [PK]
  --
  * id_sitio : INT [FK]
  * id_coordenador : INT [FK]
  * codigo : VARCHAR(24)
  * nome : VARCHAR(140)
  * objetivo : TEXT
  * data_inicio : DATE
    data_fim : DATE
  * situacao : VARCHAR(16)
  * orcamento : DECIMAL(12,2)
}
entity "participacao_campanha" as participacao_campanha {
  * <u>id_campanha</u> : INT [PK/FK]
  * <u>id_pesquisador</u> : INT [PK/FK]
  --
  * funcao : VARCHAR(60)
  * data_entrada : DATE
    data_saida : DATE
  * horas_previstas : SMALLINT
}
entity "unidade_escavacao" as unidade_escavacao {
  * <u>id_unidade</u> : INT [PK]
  --
  * id_campanha : INT [FK]
  * codigo : VARCHAR(20)
  * setor : VARCHAR(40)
    nivel_estratigrafico : VARCHAR(40)
  * data_abertura : DATE
    data_encerramento : DATE
}
entity "artefato" as artefato {
  * <u>id_artefato</u> : INT [PK]
  --
  * id_unidade : INT [FK]
    id_artefato_referencia : INT [FK]
  * codigo_catalogo : VARCHAR(32)
  * nome : VARCHAR(120)
  * descricao : TEXT
  * material : VARCHAR(60)
    periodo_estimado : VARCHAR(100)
  * data_descoberta : DATE
  * profundidade_cm : DECIMAL(7,2)
  * estado_conservacao : VARCHAR(16)
  * situacao : VARCHAR(18)
}
entity "fragmento" as fragmento {
  * <u>id_artefato</u> : INT [PK/FK]
  * <u>numero_fragmento</u> : SMALLINT [PK]
  --
  * peso_g : DECIMAL(9,3)
    comprimento_mm : DECIMAL(8,2)
    descricao : VARCHAR(240)
  * localizado : BOOLEAN
}
entity "analise_laboratorial" as analise_laboratorial {
  * <u>id_analise</u> : INT [PK]
  --
  * id_laboratorio : INT [FK]
  * tipo_analise : VARCHAR(60)
  * metodo : VARCHAR(120)
  * data_inicio : DATE
    data_fim : DATE
  * situacao : VARCHAR(16)
  * custo : DECIMAL(10,2)
}
entity "artefato_analise" as artefato_analise {
  * <u>id_artefato</u> : INT [PK/FK]
  * <u>id_analise</u> : INT [PK/FK]
  --
  * codigo_amostra : VARCHAR(32)
  * massa_consumida_g : DECIMAL(8,3)
    resultado_resumido : VARCHAR(300)
    conclusao : TEXT
}
entity "intervencao_conservacao" as intervencao_conservacao {
  * <u>id_intervencao</u> : INT [PK]
  --
  * id_artefato : INT [FK]
  * id_conservador : INT [FK]
  * tipo_intervencao : VARCHAR(80)
  * data_inicio : DATE
    data_fim : DATE
  * descricao : TEXT
    material_aplicado : VARCHAR(160)
  * situacao : VARCHAR(16)
  * custo : DECIMAL(10,2)
}
entity "local_armazenamento" as local_armazenamento {
  * <u>id_local</u> : INT [PK]
  --
  * id_instituicao : INT [FK]
  * codigo : VARCHAR(24)
  * tipo : VARCHAR(30)
    temperatura_c : DECIMAL(5,2)
    umidade_percentual : DECIMAL(5,2)
  * capacidade : INT
}
entity "custodia_artefato" as custodia_artefato {
  * <u>id_custodia</u> : INT [PK]
  --
  * id_artefato : INT [FK]
  * id_instituicao : INT [FK]
    id_local : INT [FK]
  * id_responsavel : INT [FK]
  * data_inicio : DATE
    data_fim : DATE
  * documento_movimentacao : VARCHAR(40)
  * motivo : VARCHAR(200)
    id_artefato_em_aberto : INT [gerado]
}
instituicao ||--o{ pesquisador : id_instituicao
pesquisador ||--o| arqueologo : id_pesquisador
pesquisador ||--o| conservador : id_pesquisador
pesquisador ||--o| analista_laboratorial : id_pesquisador
sitio_arqueologico ||--o{ campanha : id_sitio
pesquisador ||--o{ campanha : id_coordenador
campanha ||--o{ participacao_campanha : id_campanha
pesquisador ||--o{ participacao_campanha : id_pesquisador
campanha ||--o{ unidade_escavacao : id_campanha
unidade_escavacao ||--o{ artefato : id_unidade
artefato |o--o{ artefato : id_artefato_referencia
artefato ||--o{ fragmento : id_artefato
instituicao ||--o{ analise_laboratorial : id_laboratorio
artefato ||--o{ artefato_analise : id_artefato
analise_laboratorial ||--o{ artefato_analise : id_analise
artefato ||--o{ intervencao_conservacao : id_artefato
pesquisador ||--o{ intervencao_conservacao : id_conservador
instituicao ||--o{ local_armazenamento : id_instituicao
artefato ||--o{ custodia_artefato : id_artefato
instituicao ||--o{ custodia_artefato : id_instituicao
local_armazenamento |o--o{ custodia_artefato : id_local
pesquisador ||--o{ custodia_artefato : id_responsavel
@enduml
